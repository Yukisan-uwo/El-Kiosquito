# Copiar a .env y completar antes de `docker compose up -d --build`.
# .env nunca se commitea (agregarlo a .gitignore).

# --- Postgres operativo (001-010, backend) ---
POSTGRES_USER=elkiosquito
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_DB=elkiosquito

# --- Cuenta de servicio del ETL (rol dueno) ---
# La crea automáticamente el servicio etl-bootstrap la primera vez que
# se levanta el stack (scripts/crear_cuenta_servicio_etl.py) — acá solo
# se define con qué email/contraseña, no hace falta crearla a mano.
ETL_SERVICE_EMAIL=etl@elkiosquito.local
ETL_SERVICE_PASSWORD=cambiar-esta-contrasena

# --- ClickHouse (capa táctica) ---
# Contraseña del usuario `default` — obligatoria (ver comentario en
# docker-compose.yml, servicio clickhouse y x-airflow-common-env: bug
# real encontrado probando contra Docker real, dejarla vacía causaba
# `Code: 516. Authentication failed` desde los contenedores de Airflow).
CLICKHOUSE_PASSWORD=cambiar-esta-contrasena

# --- Airflow ---
# Clave de firma de sesiones del webserver — cualquier string largo y
# aleatorio sirve, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=cambiar-esta-clave

# --- Asistente conversacional (Art. 5.10, enmienda v1.4.0) ---
# Única dependencia de red externa del sistema en producción (Art. 5.10).
# Cuenta gratis en https://openrouter.ai/ (no requiere tarjeta) — generar
# la API key en openrouter.ai/keys. OPENROUTER_MODEL es un valor de
# configuración, no constitucional: se puede cambiar sin enmendar el
# Art. 5.10 mientras siga siendo un modelo gratuito con tool calling (ver
# docstring de backend/app/services/asistente.py).
OPENROUTER_API_KEY=OPENROUTER_API_KEY=tu-api-key-aqui
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Notificaciones al cliente por correo (Art. 8.4) ---
# Canal real para cupón de cumpleaños, cupón por patrón de compra y
# alerta de campaña de recuperación (SMS puede quedar simulado, Art. 8.4
# lo permite). Opcional: sin esto el sistema sigue funcionando, solo
# queda notificacion_enviada=false con el motivo real en cada cupón/
# campaña (nunca se simula un envío exitoso).
#
# Gmail SMTP con contraseña de aplicación (no la contraseña normal de la
# cuenta): activá verificación en 2 pasos en myaccount.google.com/security
# y generá una en myaccount.google.com/apppasswords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=tu-cuenta@gmail.com
SMTP_CONTRASENA_APP=cambiar-por-tu-contrasena-de-aplicacion
SMTP_REMITENTE_NOMBRE=El Kiosquito
